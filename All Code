                                        <span>Lost All Keys</span>
                                    </button>
                                    <button type="button" onclick="selectIssue(this, 'Locked Out of Car')" class="issue-btn flex items-center gap-2 p-2.5 rounded-xl border border-slate-200 hover:border-slate-300 text-slate-700 font-medium text-xs sm:text-sm text-left transition">
                                        <i data-lucide="lock" class="w-4 h-4 text-slate-400 shrink-0"></i>
                                        <span>Car Lockout</span>
                                    </button>
                                    <button type="button" onclick="selectIssue(this, 'Spare Key / Smart Fob')" class="issue-btn flex items-center gap-2 p-2.5 rounded-xl border border-slate-200 hover:border-slate-300 text-slate-700 font-medium text-xs sm:text-sm text-left transition">
                                        <i data-lucide="radio" class="w-4 h-4 text-slate-400 shrink-0"></i>
                                        <span>Spare Smart Fob</span>
                                    </button>
                                    <button type="button" onclick="selectIssue(this, 'Ignition / Broken Key')" class="issue-btn flex items-center gap-2 p-2.5 rounded-xl border border-slate-200 hover:border-slate-300 text-slate-700 font-medium text-xs sm:text-sm text-left transition">
                                        <i data-lucide="wrench" class="w-4 h-4 text-slate-400 shrink-0"></i>
                                        <span>Ignition Repair</span>
                                    </button>
                                </div>
                                <input type="hidden" id="selectedIssueInput" value="Lost All Keys">
                            </div>

                            <!-- Step 2: Vehicle Info -->
                            <div>
                                <label for="vehicleInput" class="block text-xs font-bold uppercase tracking-wider text-slate-500 mb-1.5">2. Vehicle Year, Make & Model</label>
                                <div class="relative">
                                    <i data-lucide="car" class="w-4 h-4 text-slate-400 absolute left-3.5 top-3.5"></i>
                                    <input id="vehicleInput" type="text" required placeholder="e.g., 2020 Honda Civic or 2019 Ford F-150" class="w-full pl-10 pr-4 py-3 rounded-xl border border-slate-200 focus:border-brand-orange focus:ring-2 focus:ring-brand-orange/20 outline-none text-sm font-medium text-brand-navy placeholder:text-slate-400">
                                </div>
                            </div>

                            <!-- Step 3: Phone & ZIP -->
                            <div class="grid grid-cols-1 sm:grid-cols-5 gap-3">
                                <div class="sm:col-span-3">
                                    <label for="phoneInput" class="block text-xs font-bold uppercase tracking-wider text-slate-500 mb-1.5">3. Your Mobile Number</label>
                                    <div class="relative">
                                        <i data-lucide="smartphone" class="w-4 h-4 text-slate-400 absolute left-3.5 top-3.5"></i>
                                        <input id="phoneInput" type="tel" required placeholder="(555) 234-5678" class="w-full pl-10 pr-4 py-3 rounded-xl border border-slate-200 focus:border-brand-orange focus:ring-2 focus:ring-brand-orange/20 outline-none text-sm font-medium text-brand-navy placeholder:text-slate-400">
                                    </div>
                                </div>
                                <div class="sm:col-span-2">
                                    <label for="zipInput" class="block text-xs font-bold uppercase tracking-wider text-slate-500 mb-1.5">Location / ZIP</label>
                                    <div class="relative">
                                        <i data-lucide="map-pin" class="w-4 h-4 text-slate-400 absolute left-3.5 top-3.5"></i>
                                        <input id="zipInput" type="text" required placeholder="ZIP or City" class="w-full pl-10 pr-3 py-3 rounded-xl border border-slate-200 focus:border-brand-orange focus:ring-2 focus:ring-brand-orange/20 outline-none text-sm font-medium text-brand-navy placeholder:text-slate-400">
                                    </div>
                                </div>
                            </div>

                            <!-- Submit CTA -->
                            <button type="submit" class="w-full bg-brand-orange hover:bg-brand-orangeHover text-white font-display font-bold text-base py-3.5 px-6 rounded-xl shadow-cta transition flex items-center justify-center gap-2 cursor-pointer">
                                <span>Text Me Exact Price & ETA</span>
                                <i data-lucide="arrow-right" class="w-4 h-4"></i>
                            </button>

                            <p class="text-[11px] text-center text-slate-400 flex items-center justify-center gap-1">
                                <i data-lucide="lock" class="w-3 h-3"></i> No spam. Technician texts back within 90 seconds.
                            </p>
                        </form>

