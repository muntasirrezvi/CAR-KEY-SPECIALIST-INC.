    <!-- ==========================================
         3. HERO SECTION + INSTANT QUOTE WIDGET
         ========================================== -->
    <section class="relative bg-brand-navy text-white overflow-hidden pt-8 pb-16 sm:py-20 lg:py-24">
        <!-- Subtle Minimal Grid Background -->
        <div class="absolute inset-0 opacity-10 pointer-events-none" style="background-image: radial-gradient(#94A3B8 1px, transparent 1px); background-size: 24px 24px;"></div>

        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
            <div class="grid lg:grid-cols-12 gap-10 lg:gap-12 items-center">
                
                <!-- Left Column: High-Impact Value Proposition -->
                <div class="lg:col-span-7 space-y-6">
                    <!-- Mobile-First Status Badge -->
                    <div class="inline-flex items-center gap-2 bg-slate-800/90 border border-slate-700 px-3.5 py-1.5 rounded-full">
                        <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
                        <span class="text-xs sm:text-sm font-medium text-slate-200">24/7 Emergency Mobile Van Dispatch</span>
                    </div>

                    <h1 class="font-display font-extrabold text-3xl sm:text-5xl lg:text-[54px] tracking-tight leading-[1.12]">
                        Lost Car Keys or Locked Out? <span class="text-brand-orange">We Come to You in 25 Mins.</span>
                    </h1>

                    <p class="text-slate-300 text-base sm:text-lg max-w-2xl leading-relaxed font-normal">
                        Skip the expensive tow truck and 5-day dealership wait. Our certified mobile locksmith vans cut and program laser keys, smart fobs, and transponders right on your driveway—for <strong class="text-white font-semibold">up to 50% less</strong>.
                    </p>

                    <!-- Prominent Dual CTAs -->
                    <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3.5 pt-1">
                        <a href="tel:8005555397" class="cta-pulse inline-flex items-center justify-center gap-3 bg-brand-orange hover:bg-brand-orangeHover text-white font-display font-bold text-lg px-7 py-4 rounded-xl shadow-cta transition text-center">
                            <i data-lucide="phone-call" class="w-5 h-5"></i>
                            <span>Call Now: (800) 555-KEYS</span>
                        </a>
                        <a href="#quote-box" class="inline-flex items-center justify-center gap-2 bg-slate-800 hover:bg-slate-700 text-white border border-slate-600 font-semibold text-base px-6 py-4 rounded-xl transition text-center">
                            <i data-lucide="calculator" class="w-5 h-5 text-brand-orange"></i>
                            <span>Get 60-Sec Price Quote</span>
                        </a>
                    </div>

                    <!-- Compact Framed Visual Card with Subtle Float & Sheen Animation -->
                    <div class="animate-float relative rounded-2xl overflow-hidden border border-slate-700/80 bg-slate-800/60 shadow-lg max-w-xl group">
                        <div class="grid sm:grid-cols-12 items-center">
                            <div class="sm:col-span-5 relative h-40 sm:h-44 overflow-hidden img-sheen">
                                <img 
                                    src="https://images.unsplash.com/photo-1617788138017-80ad40651399?auto=format&fit=crop&w=600&q=80" 
                                    alt="Modern Smart Car Key Fob & Vehicle" 
                                    onerror="this.onerror=null;this.src='https://placehold.co/600x400/1E293B/F97316?text=Smart+Key+Fob';"
                                    class="w-full h-full object-cover object-center transform group-hover:scale-105 transition duration-700 ease-out"
                                >
                                <div class="absolute inset-0 bg-gradient-to-t from-brand-navy/80 via-transparent to-transparent sm:hidden"></div>
                                <span class="absolute bottom-2.5 left-2.5 bg-brand-navy/90 backdrop-blur-md text-white text-[10px] font-bold px-2.5 py-1 rounded-md border border-slate-700 flex items-center gap-1.5 shadow-sm">
                                    <span class="relative flex h-2 w-2">
                                        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
                                        <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-400"></span>
                                    </span>
                                    <span>Mobile Van Dispatching</span>
                                    <i data-lucide="radio" class="w-3 h-3 text-brand-orange animate-pulse"></i>
                                </span>
                            </div>
                            <div class="sm:col-span-7 p-4 sm:p-5 space-y-2.5">
