                <button onclick="togglePitchModal()" class="w-full sm:w-auto bg-brand-navy text-white px-5 py-2.5 rounded-xl text-xs font-semibold hover:bg-slate-800 transition">
                    Explore Live Demo
                </button>
            </div>
        </div>
    </div>

    <!-- ==========================================
         2. STICKY MINIMALIST HEADER
         ========================================== -->
