<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Car Key Inc. | 24/7 Mobile Car Key Replacement & Emergency Locksmith</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Google Fonts: Plus Jakarta Sans & Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap" rel="stylesheet">
    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                        display: ['Plus Jakarta Sans', 'sans-serif'],
                    },
                    colors: {
                        brand: {
                            navy: '#0F172A',
                            slate: '#1E293B',
                            orange: '#F97316',
                            orangeHover: '#EA580C',
                            light: '#F8FAFC',
                        }
                    },
                    boxShadow: {
                        'soft': '0 10px 40px -10px rgba(15, 23, 42, 0.08)',
                        'cta': '0 10px 25px -5px rgba(249, 115, 22, 0.4)',
                    }
                }
            }
        }
    </script>

    <style>
        /* Custom subtle animations and scrollbar */
        @keyframes pulse-ring {
            0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(249, 115, 22, 0.7); }
            70% { transform: scale(1); box-shadow: 0 0 0 10px rgba(249, 115, 22, 0); }
            100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(249, 115, 22, 0); }
        }
        .cta-pulse {
            animation: pulse-ring 2s infinite;
        }

        /* 1. Gentle Slow-Float Animation for Hero Visual Card */
        @keyframes slow-float {
            0%, 100% { transform: translateY(0px); }
            50% { transform: translateY(-4px); }
        }
        .animate-float {
            animation: slow-float 5s ease-in-out infinite;
        }

        /* 2. Delicate Diagonal Shimmer Sweep on Image Containers */
        @keyframes sheen-sweep {
            0% { transform: translateX(-140%) skewX(-20deg); }
            35%, 100% { transform: translateX(220%) skewX(-20deg); }
        }
        .img-sheen::after {
            content: "";
            position: absolute;
            top: 0;
            left: 0;
            width: 45%;
            height: 100%;
            background: linear-gradient(
                90deg,
                rgba(255, 255, 255, 0) 0%,
                rgba(255, 255, 255, 0.16) 50%,
                rgba(255, 255, 255, 0) 100%
            );
            animation: sheen-sweep 7s ease-in-out infinite;
            pointer-events: none;
        }

        /* 3. Scroll-Reveal & Micro-Interaction Classes for Service Images */
        .reveal-card {
            opacity: 0;
            transform: translateY(18px) scale(0.98);
            transition: opacity 0.65s cubic-bezier(0.22, 1, 0.36, 1),
                        transform 0.65s cubic-bezier(0.22, 1, 0.36, 1),
                        border-color 0.3s ease;
        }
        .reveal-card.is-visible {
            opacity: 1;
            transform: translateY(0) scale(1);
        }
        .service-img-zoom {
            transition: transform 0.55s cubic-bezier(0.22, 1, 0.36, 1),
                        filter 0.55s ease;
        }
        .group:hover .service-img-zoom,
        .group:active .service-img-zoom {
            transform: scale(1.06);
            filter: brightness(1.06);
        }
        .badge-float {
            transition: transform 0.35s cubic-bezier(0.22, 1, 0.36, 1);
        }
        .group:hover .badge-float {
            transform: translateY(-2px);
        }

        /* 4. Subtle Workshop Van Border Glow */
        @keyframes border-glow {
            0%, 100% { box-shadow: 0 0 0 0 rgba(249, 115, 22, 0.35); }
            50% { box-shadow: 0 0 0 5px rgba(249, 115, 22, 0); }
        }
        .van-pulse-border {
            animation: border-glow 3.5s infinite;
        }

        /* Ensure bottom mobile action bar doesn't cover footer content */
        body {
            padding-bottom: 80px;
        }
        @media (min-width: 768px) {
            body {
                padding-bottom: 0;
            }
        }
    </style>
</head>
<body class="bg-brand-light text-slate-800 font-sans antialiased selection:bg-brand-orange selection:text-white">

