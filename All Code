                                        <span>Upfront Pricing</span>
                                    </div>
                                    <div class="flex items-center gap-1.5">
                                        <i data-lucide="check-circle-2" class="w-3.5 h-3.5 text-brand-orange shrink-0"></i>
                                        <span>Zero Towing Cost</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Right Column: 3-Tap Mobile Quote & Dispatch Widget -->
                <div id="quote-box" class="lg:col-span-5">
                    <div class="bg-white text-slate-800 rounded-2xl p-6 sm:p-8 shadow-2xl border border-slate-100">
                        <div class="flex items-center justify-between mb-4">
                            <div>
                                <span class="text-xs font-bold uppercase tracking-wider text-brand-orange">Fastest Response</span>
                                <h2 class="font-display font-bold text-xl sm:text-2xl text-brand-navy">Instant Price & ETA Quote</h2>
                            </div>
                            <div class="w-10 h-10 rounded-full bg-orange-50 flex items-center justify-center text-brand-orange">
                                <i data-lucide="zap" class="w-5 h-5"></i>
                            </div>
                        </div>

                        <!-- Interactive Form -->
                        <form id="quoteForm" onsubmit="handleQuoteSubmit(event)" class="space-y-4">
                            <!-- Step 1: Service Type -->
                            <div>
                                <label class="block text-xs font-bold uppercase tracking-wider text-slate-500 mb-1.5">1. What do you need help with?</label>
