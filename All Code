                        <span class="flex items-center gap-1.5 text-xs font-medium text-slate-700"><span class="w-4 h-4 rounded-full bg-[#F97316] inline-block"></span> #F97316 Action Orange</span>
                        <span class="flex items-center gap-1.5 text-xs font-medium text-slate-700"><span class="w-4 h-4 rounded-full bg-[#F8FAFC] border border-slate-300 inline-block"></span> #F8FAFC Minimal Gray</span>
