                                    <button type="button" onclick="selectIssue(this, 'Lost All Keys')" class="issue-btn active-issue flex items-center gap-2 p-2.5 rounded-xl border-2 border-brand-orange bg-orange-50/60 text-brand-navy font-semibold text-xs sm:text-sm text-left transition">
