    <script>
        // Initialize Lucide icons
        lucide.createIcons();

        // Toggle Pitch Modal
        function togglePitchModal() {
            const modal = document.getElementById('pitchModal');
            if (modal.classList.contains('hidden')) {
                modal.classList.remove('hidden');
                modal.classList.add('flex');
            } else {
                modal.classList.add('hidden');
                modal.classList.remove('flex');
            }
        }

        // Select Issue Pill in Quote Widget
        function selectIssue(buttonEl, issueName) {
            const allBtns = document.querySelectorAll('.issue-btn');
            allBtns.forEach(btn => {
                btn.className = 'issue-btn flex items-center gap-2 p-2.5 rounded-xl border border-slate-200 hover:border-slate-300 text-slate-700 font-medium text-xs sm:text-sm text-left transition';
                const icon = btn.querySelector('svg');
                if (icon) {
                    icon.classList.remove('text-brand-orange');
                    icon.classList.add('text-slate-400');
                }
            });

            buttonEl.className = 'issue-btn active-issue flex items-center gap-2 p-2.5 rounded-xl border-2 border-brand-orange bg-orange-50/60 text-brand-navy font-semibold text-xs sm:text-sm text-left transition';
            const activeIcon = buttonEl.querySelector('svg');
            if (activeIcon) {
                activeIcon.classList.remove('text-slate-400');
                activeIcon.classList.add('text-brand-orange');
            }

            document.getElementById('selectedIssueInput').value = issueName;
        }

        // Prefill service from service cards
        function prefillService(serviceName) {
            const buttons = document.querySelectorAll('.issue-btn');
            buttons.forEach(btn => {
                if (btn.innerText.trim().includes(serviceName.split(' ')[0])) {
                    selectIssue(btn, serviceName);
                }
            });
            setTimeout(() => {
                document.getElementById('vehicleInput').focus();
            }, 400);
        }

        // Handle Instant Quote Submission Demo
        function handleQuoteSubmit(e) {
            e.preventDefault();
            const issue = document.getElementById('selectedIssueInput').value;
            const vehicle = document.getElementById('vehicleInput').value;
            const phone = document.getElementById('phoneInput').value;
            const zip = document.getElementById('zipInput').value;

            const summaryEl = document.getElementById('quoteSuccessSummary');
            summaryEl.innerHTML = `We are calculating the exact price for your <strong>${vehicle}</strong> (${issue}) near <strong>${zip}</strong> and texting <strong>${phone}</strong> right now.`;

            document.getElementById('quoteForm').classList.add('hidden');
            document.getElementById('quoteSuccess').classList.remove('hidden');
        }

        function resetQuoteForm() {
            document.getElementById('quoteForm').reset();
            document.getElementById('quoteForm').classList.remove('hidden');
            document.getElementById('quoteSuccess').classList.add('hidden');
        }

        // Scroll-Reveal Animation Observer for Service Cards & Van Banner
        document.addEventListener('DOMContentLoaded', () => {
            const revealCards = document.querySelectorAll('.reveal-card');
            if ('IntersectionObserver' in window) {
                const observer = new IntersectionObserver((entries, obs) => {
                    entries.forEach(entry => {
                        if (entry.isIntersecting) {
                            entry.target.classList.add('is-visible');
                            obs.unobserve(entry.target);
                        }
                    });
                }, { threshold: 0.12 });

                revealCards.forEach(card => observer.observe(card));
            } else {
                revealCards.forEach(card => card.classList.add('is-visible'));
            }
        });
    </script>
